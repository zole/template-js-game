{
    "extends": "@tsconfig/recommended/tsconfig.json",
    "compilerOptions": {
        "sourceMap": true,
        "module": "esnext",
        "moduleResolution": "bundler",

        "allowJs": true,
        "resolveJsonModule": true,
        "lib": ["esnext", "DOM", "WebWorker"]
    },
    "references": [{ "path": "../lib" }],
    "include": ["**/*.ts"],
    "exclude": ["**/unused/**/*"]
}
