{
    "extends": "@tsconfig/recommended/tsconfig.json",
    "compilerOptions": {
        "sourceMap": true,
        "module": "esnext",
        "moduleResolution": "bundler",

        "allowJs": true,
        "resolveJsonModule": true,
        "lib": ["esnext", "DOM", "WebWorker"],
        "types": ["vite-plugin-glsl/ext"]
    },
    "include": ["**/*.ts"],
    "exclude": ["**/unused/**/*"]
}
